APP_NAME="Sistema Centralizado de Proyectos de Grado"
APP_ENV=local
APP_KEY=
# Template used as-is by CI and fresh deployments: debug stays OFF so a
# deploy that copies this file never leaks env vars in error pages.
# Set APP_DEBUG=true for local development only.
APP_DEBUG=false
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — PostgreSQL 16 (matches stack; run via Sail in local dev)
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=proyecto_grado
DB_USERNAME=sail
DB_PASSWORD=password

# ---------------------------------------------------------------------------
# Session & cache — database (issue #10: single-session enforcement
# queries the `sessions` table by `user_id`; the `database` driver
# gives us a queryable session store. The `sessions` table is
# created by the framework's default migration.)
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
# HTTPS-only session cookie (single definition — was duplicated with
# opposite values). Keep true for the Azure deployment behind TLS;
# set false for plain-HTTP local development on browsers that do not
# exempt localhost from the Secure attribute.
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@proyectos.unab.edu.co"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AWS (unused in this change, kept for Laravel defaults)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Vite / React SPA dev server
# ---------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_PORT=5173
VITE_API_BASE_URL="${APP_URL}/api"

# ---------------------------------------------------------------------------
# Laravel Sanctum (cookie-based SPA auth)
# ---------------------------------------------------------------------------
# Comma-separated list of origins allowed to use Sanctum cookie auth.
# In local dev: the Vite server (http://localhost:5173) AND the Laravel host.
# In production: replace with the real app domain over HTTPS.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1:5173,127.0.0.1:8000
SANCTUM_TOKEN_PREFIX=
SANCTUM_GUARD=web
SANCTUM_EXPIRATION=480

# CORS — origins that may call the API from the browser with credentials.
# Must match the SPA dev server URL. Production must replace these.
FRONTEND_URL=http://localhost:5173
SANCTUM_CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ---------------------------------------------------------------------------
# Google OAuth (Laravel Socialite) — required for institutional login
# ---------------------------------------------------------------------------
# Create OAuth 2.0 client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match exactly: ${APP_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/callback"

# UNAB tenant restriction — only @unab.edu.co Google Workspace users can log in
GOOGLE_ALLOWED_HOSTED_DOMAIN=unab.edu.co
GOOGLE_ALLOWED_EMAIL_DOMAIN=unab.edu.co

# ---------------------------------------------------------------------------
# AI island (NullAiProvider until a real FastAPI/OpenAI bridge is registered)
# ---------------------------------------------------------------------------
AI_PROVIDER=null
