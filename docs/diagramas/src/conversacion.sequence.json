  "cards": [
    {
      "dot": "cyan",
      "title": "Lo que no se ve en el dibujo",
      "items": [
        "Cada flecha HTTP entra por Nginx :80 y llega a PHP-FPM por FastCGI en 127.0.0.1:9000",
        "auth:sanctum resuelve la identidad, single_session corta la sesión anterior y activity marca la actividad"
      ]
    },
    {
      "dot": "amber",
      "title": "Detalles que sorprenden",
      "items": [
        "El botón de Google es un enlace normal, no un fetch: por eso el SPA se recarga entero",
        "El evaluador externo no pasa por Google: entra por POST /api/auth/externo/login con throttle:login"
      ]
    }
  ]
